{
  "extends": [
    "local>micronaut-projects/micronaut-project-template//.github/renovate-global"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "src/it/package-docker-native-different-parent-version/pom.xml"
      ],
      "matchPackageNames": [
        "io.micronaut:micronaut-parent"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "src/main/resources/dockerfiles/Dockerfile*"
      ],
      "matchPackageNames": [
        "eclipse-temurin",
        "amazonlinux"
      ],
      "enabled": false
    }
  ]
}
