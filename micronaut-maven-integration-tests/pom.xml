<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.micronaut.maven</groupId>
        <artifactId>micronaut-maven-plugin-parent</artifactId>
        <version>5.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>micronaut-maven-integration-tests</artifactId>
    <packaging>jar</packaging>

    <name>Micronaut Maven Plugin - Integration Tests</name>
    <description>Integration tests for Micronaut Maven Plugin</description>
    <url>https://github.com/micronaut-projects/micronaut-maven-plugin</url>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>

        <it.micronaut.core.version>5.0.0</it.micronaut.core.version>
        <it.micronaut.version>5.0.0-RC1</it.micronaut.version>
        <!--
          A Micronaut core version that has micronaut.application.training.mode (micronaut-projects/micronaut-core#13402),
          for the *-jdk-aot-cache-load projects, which train a JDK AOT cache without starting the application. They are
          skipped while this is empty, because no such version is released yet. To run them, publish that core build to
          the local Maven repository under a version that no remote repository has, because Maven prefers the published
          5.3.0-SNAPSHOT of the 5.3.x branch to a local one, and pass the version, for example
          -Dit.micronaut.core.trainingMode.version=5.3.0-pr13402-SNAPSHOT

          TODO when a Micronaut core release has the mode ({{LOAD_ITS_ISSUE}}): set this property to it, so that CI runs
          these projects, which are the only end-to-end check of the default training mode. When it.micronaut.version
          itself has the mode, remove the property, the selector.groovy files and the micronaut.core.version of these
          projects instead.
        -->
        <it.micronaut.core.trainingMode.version/>
        <!--
          A Micronaut version without the training-run switch (micronaut.application.training.enabled), for the projects
          that cover the JDK AOT cache training of such a version, where the plugin's script warms the application up,
          fails on a status of 400 or more and stops the application with SIGTERM: package-docker-jdk-aot-cache,
          package-docker-jdk-aot-cache-failure and dockerfile-docker-jdk-aot-cache. It is not it.micronaut.version on
          purpose: do not raise it to a version with the switch. With such a version the same builds behave differently
          (trainingPaths without a trainingMode fails the build, and a 404 of a training path is only a warning).
        -->
        <it.micronaut.noTrainingSwitch.version>5.0.0-RC1</it.micronaut.noTrainingSwitch.version>

        <!-- Enable recording of coverage during execution of maven-invoker-plugin -->
        <jacoco.propertyName>invoker.mavenOpts</jacoco.propertyName>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.micronaut.maven</groupId>
            <artifactId>micronaut-maven-aot-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micronaut.maven</groupId>
            <artifactId>micronaut-maven-aot-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micronaut.maven</groupId>
            <artifactId>micronaut-maven-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micronaut.maven</groupId>
            <artifactId>micronaut-maven-enforcer-rules</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micronaut.maven</groupId>
            <artifactId>micronaut-maven-jib-integration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micronaut.maven</groupId>
            <artifactId>micronaut-maven-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>5.0.6</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <streamLogsOnFailures>true</streamLogsOnFailures>
                    <failIfNoProjects>true</failIfNoProjects>
                    <cloneProjectsTo>../target/it</cloneProjectsTo>
                    <pomIncludes>
                        <pomInclude>*/pom.xml</pomInclude>
                    </pomIncludes>
                    <setupIncludes>
                        <setupInclude>openapi-setup/pom.xml</setupInclude>
                    </setupIncludes>
                    <preBuildHookScript>setup</preBuildHookScript>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <selectorScript>selector</selectorScript>
                    <localRepositoryPath>../target/local-repo</localRepositoryPath>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <filterProperties>
                        <trainingModeCoreVersion>${it.micronaut.core.trainingMode.version}</trainingModeCoreVersion>
                    </filterProperties>
                    <scriptVariables>
                        <nativeMavenPluginVersion>${native-maven-plugin.version}</nativeMavenPluginVersion>
                        <pluginVersion>${project.version}</pluginVersion>
                        <trainingModeCoreVersion>${it.micronaut.core.trainingMode.version}</trainingModeCoreVersion>
                    </scriptVariables>
                    <goals>
                        <goal>clean</goal>
                        <goal>install</goal>
                    </goals>
                    <extraArtifacts>
                        <extraArtifact>org.jacoco:org.jacoco.agent:${jacoco.version}:jar:runtime</extraArtifact>
                    </extraArtifacts>
                    <writeJunitReport>true</writeJunitReport>
                    <properties>
                        <jdk.version>${java.specification.version}</jdk.version>
                    </properties>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
